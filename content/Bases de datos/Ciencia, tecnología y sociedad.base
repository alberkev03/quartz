views:
  - type: table
    name: Tabla
    filters:
      and:
        - file.tags.contains("ciencia-tecnologia-sociedad")
        - file.folder != "/"
    order:
      - file.name
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    limit: 10
    columnSize:
      file.name: 483
